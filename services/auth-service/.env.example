# Copy this file to .env and replace all example values before starting the service.
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/campus_auth
JWT_SECRET=replace-with-a-long-random-secret-before-use
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# The service creates this administrator at startup only when no account exists.
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-strong-admin-password
