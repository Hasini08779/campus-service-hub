# Copy this file to .env and replace the example secret before starting the service.
PORT=5003
MONGODB_URI=mongodb://127.0.0.1:27017/campus_events

# Must match JWT_SECRET used by auth-service.
JWT_SECRET=replace-with-the-same-long-random-secret-used-by-auth-service
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# Optional; notifications are best-effort and will be skipped when unset.
NOTIFICATION_SERVICE_URL=http://localhost:5005
STUDENT_SERVICE_URL=http://localhost:5002
