# Copy this file to .env and replace the example secret before starting the service.
PORT=5002
MONGODB_URI=mongodb://127.0.0.1:27017/campus_students

# Must match JWT_SECRET used by auth-service so this service can verify its tokens.
JWT_SECRET=replace-with-the-same-long-random-secret-used-by-auth-service
CORS_ORIGIN=http://localhost:5173
